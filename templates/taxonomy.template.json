{
  "$comment": "Vita taxonomy, the ONE vocabulary of the product. Example values use the demo product 'Theo', a platform that deploys custom AI agents. Maintained with the vita-personas skill; enforced by vita-content + vita-audit (avoid list).",
  "product": "Theo",
  "personas": ["agent-builder", "business-owner"],
  "objects": {
    "agent": {
      "singular": "agent",
      "plural": "agents",
      "definition": "A custom AI worker with instructions, knowledge and tools, deployed to do one job.",
      "icon": "Bot",
      "overrides": { "business-owner": { "singular": "assistant", "plural": "assistants" } }
    },
    "deployment": {
      "singular": "deployment",
      "plural": "deployments",
      "definition": "A version of an agent running in an environment (staging or production).",
      "icon": "Deploy"
    },
    "run": {
      "singular": "run",
      "plural": "runs",
      "definition": "One execution of an agent, from trigger to result.",
      "icon": "Activity"
    },
    "knowledge-source": {
      "singular": "knowledge source",
      "plural": "knowledge sources",
      "definition": "Documents, sites or data the agent is allowed to answer from.",
      "icon": "Book"
    },
    "tool": {
      "singular": "tool",
      "plural": "tools",
      "definition": "A connected app the agent can act in (Slack, Salesforce, Gmail…).",
      "icon": "Plug"
    },
    "workspace": {
      "singular": "workspace",
      "plural": "workspaces",
      "definition": "A team's space: its agents, members, tools and billing.",
      "icon": "Enterprise"
    }
  },
  "actions": {
    "create": { "label": "Create {object}", "icon": "Add", "variant": "primary", "confirm": false },
    "edit": { "label": "Edit", "icon": "Edit", "variant": "ghost", "confirm": false },
    "test": { "label": "Test agent", "icon": "Play", "variant": "secondary", "confirm": false },
    "deploy": { "label": "Deploy agent", "icon": "Deploy", "variant": "primary", "confirm": true },
    "pause": { "label": "Pause", "icon": "Pause", "variant": "menu", "confirm": false, "undo": true },
    "duplicate": { "label": "Duplicate", "icon": "Copy", "variant": "menu", "confirm": false },
    "delete": { "label": "Delete {object}", "icon": "TrashCan", "variant": "danger", "confirm": true },
    "export": { "label": "Export", "icon": "Download", "variant": "tertiary", "confirm": false }
  },
  "statuses": {
    "agent": {
      "Draft": "draft",
      "Deploying": "in-progress",
      "Live": "success",
      "Degraded": "warning",
      "Paused": "draft",
      "Failed": "error"
    },
    "run": {
      "Queued": "pending",
      "Running": "in-progress",
      "Handed off": "info",
      "Succeeded": "success",
      "Failed": "error"
    }
  },
  "avoid": {
    "Submit": "a verb + object, e.g. \"Deploy agent\"",
    "Oops": "say what happened and how to fix it",
    "Successfully": "(remove, success is implied)",
    "Bot": "agent",
    "Robot": "agent",
    "Job": "run",
    "Sign in": "Log in",
    "Sign out": "Log out"
  },
  "voice": {
    "rules": ["Sentence case", "Front-load the key word", "Numerals for numbers", "No blame", "No 'please', 'simply', 'just'", "Never anthropomorphise agents ('thinks', 'wants')"],
    "personas": {
      "agent-builder": "Technical, terse; terms like model, prompt, tool call and evaluation are welcome.",
      "business-owner": "Plain language, outcome-first (tickets resolved, hours saved), no jargon."
    }
  }
}
