{
  "name": "@corpus/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Corpus — an opinionated, AI-agent-first design system: tokens, components, patterns, skills and enforcement.",
  "bin": {
    "corpus": "./bin/corpus.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "audit:ds": "node scripts/corpus-audit.mjs",
    "llms": "node scripts/build-llms.mjs",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm audit:ds && pnpm test",
    "palette": "node scripts/build-palette.mjs"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.89.0",
    "@carbon/pictograms-react": "^11.111.0",
    "@fontsource-variable/google-sans-code": "^5.3.1",
    "@fontsource-variable/google-sans-flex": "^5.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "marked": "^18.0.14",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "files": [
    "bin",
    "src/registry",
    "src/styles",
    "docs",
    "skills",
    "templates",
    "scripts",
    "eslint",
    "AGENTS.md",
    "llms.txt"
  ],
  "engines": {
    "node": ">=20.19"
  }
